diff --git a/packages/coding-agent/test/tool-load-append.test.ts b/packages/coding-agent/test/tool-load-append.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3ccdbbe579f358809be586a88fb24e961d9f8802
--- /dev/null
+++ b/packages/coding-agent/test/tool-load-append.test.ts
@@ -0,0 +1,165 @@
+import { fauxAssistantMessage, fauxToolCall, getCurrentTools, type TranscriptContext } from "@earendil-works/pi-ai";
+import { Type } from "typebox";
+import { afterEach, describe, expect, it } from "vitest";
+import type { ExtensionAPI } from "../src/core/extensions/types.ts";
+import { createToolSearchExtension } from "../src/extensions/tool-search/index.ts";
+import { createHarness, type Harness } from "./suite/harness.ts";
+
+const guideline = "Check the launch window before launching a satellite.";
+const snippet = "Launch a satellite.";
+const satelliteTools = (pi: ExtensionAPI) => {
+	pi.registerTool({
+		name: "launch_satellite",
+		label: "Launch satellite",
+		description: snippet,
+		promptSnippet: snippet,
+		promptGuidelines: [guideline],
+		exposure: "deferred",
+		parameters: Type.Object({}),
+		execute: async () => ({ content: [], details: {} }),
+	});
+};
+
+const harnesses: Harness[] = [];
+afterEach(() => {
+	while (harnesses.length > 0) harnesses.pop()?.cleanup();
+});
+
+async function setup(sessionManager?: Harness["sessionManager"], forced = false, hidden = false) {
+	const harness = await createHarness({
+		sessionManager,
+		extensionFactories: [
+			satelliteTools,
+			createToolSearchExtension(),
+			...(forced
+				? [
+						(pi: ExtensionAPI) => {
+							pi.on("before_agent_start", () => ({ systemPrompt: "Exact Agent prompt." }));
+							if (hidden)
+								pi.registerTool({
+									name: "bridge",
+									label: "Bridge",
+									description: "Calls hidden tools.",
+									parameters: Type.Object({}),
+									prepareLoadout: () => ({ hiddenDeclarations: ["bash"] }),
+									execute: async () => ({ content: [], details: {} }),
+								});
+						},
+					]
+				: []),
+		],
+	});
+	harnesses.push(harness);
+	return harness;
+}
+
+async function prompt(harness: Harness) {
+	harness.setResponses([fauxAssistantMessage("done")]);
+	await harness.session.prompt("continue");
+}
+
+function guidelineUpdates(harness: Harness) {
+	return harness.session.messages.filter(
+		(message) => message.role === "system" && JSON.stringify(message.sections).includes(guideline),
+	);
+}
+
+describe("tool-load-append", () => {
+	it.each([false, true])("preserves the forced head and appended tool_search updates (hidden: %s)", async (hidden) => {
+		const harness = await setup(undefined, true, hidden);
+		harness.session.setActiveToolsByName([...harness.session.getActiveToolNames(), "tool_search"]);
+		const requests: TranscriptContext[] = [];
+		const capture = (context: TranscriptContext) => {
+			requests.push(context);
+			return fauxAssistantMessage("done");
+		};
+		harness.setResponses([capture]);
+		await harness.session.prompt("start");
+		const head = JSON.stringify(requests[0]!.messages[0]);
+		harness.setResponses([
+			fauxAssistantMessage([fauxToolCall("tool_search", { query: "launch satellite", limit: 1 })], {
+				stopReason: "toolUse",
+			}),
+			capture,
+		]);
+		await harness.session.prompt("load the launch tool");
+		expect(JSON.stringify(requests[1]!.messages[0])).toBe(head);
+		expect(requests[1]!.messages.slice(0, requests[0]!.messages.length)).toEqual(requests[0]!.messages);
+		if (hidden) expect(getCurrentTools(requests[1]!.messages).map((tool) => tool.name)).not.toContain("bash");
+		expect(requests[1]!.messages[0]).toMatchObject({ role: "system", content: "Exact Agent prompt." });
+		const updates = requests[1]!.messages.slice(1).filter((message) => message.role === "system");
+		expect(updates.some((message) => message.toolsAdded?.some((tool) => tool.name === "launch_satellite"))).toBe(
+			true,
+		);
+		expect(JSON.stringify(updates)).toContain(guideline);
+		expect(JSON.stringify(updates)).toContain(snippet);
+		harness.session.setActiveToolsByName(["read"]);
+		harness.setResponses([capture]);
+		await harness.session.prompt("remove the launch tool");
+		expect(getCurrentTools(requests[2]!.messages).map((tool) => tool.name)).toEqual(["read"]);
+	});
+
+	it("keeps the initial prompt and request prefix while appending tool_search guidelines and declarations", async () => {
+		const harness = await setup();
+		harness.session.setActiveToolsByName([...harness.session.getActiveToolNames(), "tool_search"]);
+		await prompt(harness);
+		const initialPrompt = harness.session.systemPrompt;
+		const prefix = JSON.parse(JSON.stringify(harness.session.messages));
+		let request: TranscriptContext | undefined;
+		harness.setResponses([
+			fauxAssistantMessage([fauxToolCall("tool_search", { query: "launch satellite", limit: 1 })], {
+				stopReason: "toolUse",
+			}),
+			(context) => {
+				request = context;
+				return fauxAssistantMessage("loaded");
+			},
+		]);
+		// The activation happens during the tool call, before prepareNextTurn appends its diff.
+		harness.session.subscribe((event) => {
+			if (event.type === "tool_execution_end" && event.toolName === "tool_search") {
+				expect(harness.session.systemPrompt).toBe(initialPrompt);
+			}
+		});
+		await harness.session.prompt("find the launch tool");
+		expect(harness.session.systemPrompt).toBe(initialPrompt);
+		expect(request).toBeDefined();
+		expect(request?.messages.slice(0, prefix.length)).toEqual(prefix);
+		expect(getCurrentTools(request?.messages ?? []).map((tool) => tool.name)).toContain("launch_satellite");
+		expect(guidelineUpdates(harness)).toHaveLength(1);
+		expect(JSON.stringify(guidelineUpdates(harness)[0])).toContain(snippet);
+		await prompt(harness);
+		expect(guidelineUpdates(harness)).toHaveLength(1);
+	});
+
+	it("keeps the prompt on a superset activation but rebuilds for removal and fresh sessions", async () => {
+		const harness = await setup();
+		const initial = harness.session.systemPrompt;
+		const tools = harness.session.getActiveToolNames();
+		harness.session.setActiveToolsByName([...tools, "launch_satellite"]);
+		expect(harness.session.systemPrompt).toContain(guideline);
+		harness.session.setActiveToolsByName(tools);
+		expect(harness.session.systemPrompt).toBe(initial);
+		await prompt(harness);
+		harness.session.setActiveToolsByName([...tools, "launch_satellite"]);
+		expect(harness.session.systemPrompt).toBe(initial);
+		await prompt(harness);
+		harness.session.setActiveToolsByName(["launch_satellite"]);
+		expect(harness.session.systemPrompt).toContain(guideline);
+		expect(harness.session.systemPrompt).not.toBe(initial);
+	});
+
+	it.each(["resume", "reload"] as const)("does not repeat the persisted guideline update after %s", async (action) => {
+		let harness = await setup();
+		await prompt(harness);
+		harness.session.setActiveToolsByName([...harness.session.getActiveToolNames(), "launch_satellite"]);
+		await prompt(harness);
+		expect(guidelineUpdates(harness)).toHaveLength(1);
+		if (action === "resume") harness = await setup(harness.sessionManager);
+		else await harness.session.reload();
+		expect(harness.session.getActiveToolNames()).toContain("launch_satellite");
+		expect(harness.session.systemPrompt).toContain(guideline);
+		await prompt(harness);
+		expect(guidelineUpdates(harness)).toHaveLength(1);
+	});
+});
