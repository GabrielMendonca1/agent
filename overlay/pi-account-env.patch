+		writeFileSync(bucketPath, JSON.stringify({ version: 1, active, accounts }));
+	const readJson = (path: string) => JSON.parse(readFileSync(path, "utf-8"));
+	const auth = async (storage: AuthStorage, provider: Provider) => {
+		const models = createModels({ credentials: storage });
+		models.setProvider(provider);
+		return (await models.getAuth(PROVIDER))?.auth;
+	};
+
+	beforeEach(() => {
+		if (existsSync(dir)) rmSync(dir, { recursive: true });
+		mkdirSync(dir, { recursive: true });
+		delete process.env[ENV];
+	});
