+
+const PROVIDER = "anthropic";
+const ENV = "PI_ACCOUNT_ANTHROPIC";
+
+function oauth(tag: string, expiresIn: number, extra: Record<string, unknown> = {}): Credential {
+	return {
+		type: "oauth",
+		access: `access-${tag}`,
+		refresh: `refresh-${tag}`,
+		expires: Date.now() + expiresIn,
+		...extra,
+	};
+}
+
+/** OAuth server double: each refresh token works once (Anthropic rotates and kills the old one). */
+function rotatingProvider() {
+	const used = new Set<string>();
+	let calls = 0;
+	const provider: Provider = {
+		id: PROVIDER,
+		name: "Rotating",
+		auth: {
+			oauth: {
+				name: "OAuth",
+				login: async () => {
+					throw new Error("not used");
+				},
+				refresh: async (credential) => {
+					calls++;
+					if (used.has(credential.refresh)) throw new Error(`refresh token reused: ${credential.refresh}`);
+					used.add(credential.refresh);
+					await new Promise((resolve) => setTimeout(resolve, 30));
+					return {
+						...credential,
+						access: `${credential.access}+`,
+						refresh: `${credential.refresh}+`,
+						expires: Date.now() + 3_600_000,
+					};
+				},
+				toAuth: async (credential) => ({ apiKey: credential.access }),
+			},
+		},
+		getModels: () => [],
+		stream: () => {
+			throw new Error("not used");
+		},
+		streamSimple: () => {
+			throw new Error("not used");
+		},
+	};
+	return { provider, calls: () => calls };
+}
