diff --git a/packages/coding-agent/src/core/account-selection.ts b/packages/coding-agent/src/core/account-selection.ts
new file mode 100644
index 0000000000000000000000000000000000000000..36298a08815cfdaabd281bffe2623b2a0a00aef0
--- /dev/null
+++ b/packages/coding-agent/src/core/account-selection.ts
@@ -0,0 +1,457 @@
+/**
+ * ARCA overlay (pi-account-env): per-session account selection.
+ *
+ * `PI_ACCOUNT_<PROVIDER>=<name>` makes this process resolve that provider's credential from
+ * `accounts.json` (the `/accounts` bucket next to auth.json) instead of auth.json. Strict: a
+ * missing account or a failed refresh is an error, never a fallback to auth.json.
+ *
+ * Every refresh that touches the bucket runs under the proper-lockfile lock of accounts.json and,
+ * when auth.json is involved, of auth.json too (order: accounts.json -> auth.json). A rotation is
+ * first written to a journal (`accounts.rotations/`), then to accounts.json, then to auth.json, and
+ * the journal is removed last. A kill or a compromised lock at any point leaves the journal, and the
+ * next locked operation replays it: every copy still holding the consumed refresh token (bucket
+ * entries and the auth.json slot) receives the rotated credential. A refreshed token is never lost.
+ */
+
+import type { AuthOperationOptions, Credential, CredentialInfo } from "@earendil-works/pi-ai";
+import { existsSync, mkdirSync, readdirSync, readFileSync, renameSync, rmSync, writeFileSync } from "fs";
+import { dirname, join } from "path";
+import lockfile from "proper-lockfile";
+import { setTimeout as sleep } from "timers/promises";
+import { stripBom } from "../utils/text.ts";
+
+/** Printed by `pi --arca-capabilities`; the app enables per-project accounts only when present. */
+export const ARCA_CAPABILITIES = { accountEnv: 1 } as const;
+
+const KNOWN_PROVIDERS = ["anthropic", "openai-codex"];
+const LOCK_STALE_MS = 30_000;
+
+interface Bucket {
+	version?: number;
+	active?: Record<string, string>;
+	accounts?: Record<string, Record<string, Credential>>;
+}
+
+export function accountEnvName(providerId: string): string {
+	return `PI_ACCOUNT_${providerId.toUpperCase().replace(/[^A-Z0-9]/g, "_")}`;
+}
+
+export function selectedAccount(providerId: string, env: NodeJS.ProcessEnv = process.env): string | undefined {
+	return env[accountEnvName(providerId)]?.trim() || undefined;
+}
+
+export class AccountSelectionError extends Error {}
+
+/**
+ * Lockstep with the `/accounts` extension (P1): the extension that writes accounts.json must use the
+ * same lock protocol and per-entry merge, or it reverts rotations made here. A compatible extension
+ * sets this global to >= ACCOUNTS_LOCK_PROTOCOL when it loads. If an extension registers
+ * `/accounts` without it, PI_ACCOUNT_* is refused in this process.
+ */
+export const ACCOUNTS_LOCK_PROTOCOL = 2;
+const LOCK_PROTOCOL_KEY = Symbol.for("arca.accounts.lockProtocol");
+let legacyAccountsWriter: string | undefined;
+
+export function noteAccountsWriters(
+	extensions: readonly { path: string; commands: ReadonlyMap<string, unknown> }[],
+): void {
+	const declared = Number((globalThis as Record<symbol, unknown>)[LOCK_PROTOCOL_KEY] ?? 0);
+	const writer = extensions.find((extension) => extension.commands.has("accounts"));
+	legacyAccountsWriter = writer && !(declared >= ACCOUNTS_LOCK_PROTOCOL) ? writer.path : undefined;
+}
+
+function assertCompatibleWriters(providerId: string, name: string): void {
+	if (!legacyAccountsWriter) return;
+	throw new AccountSelectionError(
+		`${accountEnvName(providerId)}=${name} refused: the /accounts extension loaded from ${legacyAccountsWriter} ` +
+			`uses the old accounts.json lock and would revert token rotations. Update it (ARCA/arca >= 3baf05e) ` +
+			`or open this Pi without ${accountEnvName(providerId)}.`,
+	);
+}
+
+/**
+ * Providers with a `/login` in flight in this process (set by ModelRuntime.login). A login is not
+ * a rotation of the active account, so it must never be chained into accounts.json.
+ */
+export const loginsInProgress = new Set<string>();
+
+function refreshOf(credential: Credential | undefined): unknown {
+	return credential?.type === "oauth" ? credential.refresh : undefined;
+}
+
+type SlotWriter = (
+	providerId: string,
+	fn: (slot: Credential | undefined) => Promise<Credential | undefined>,
+	options?: AuthOperationOptions,
+) => Promise<unknown>;
+
+interface Rotation {
+	provider: string;
+	from: string;
+	to: Credential;
+}
+
+interface Locked {
+	/** True once the lock was lost: skip writes; the journal keeps the rotation. */
+	compromised: () => boolean;
+}
+
+function rotated(before: Credential | undefined, after: Credential | undefined): before is Credential {
+	return (
+		before?.type === "oauth" &&
+		after?.type === "oauth" &&
+		typeof before.refresh === "string" &&
+		before.refresh !== after.refresh
+	);
+}
+
+export class AccountCredentials {
+	readonly bucketPath: string;
+	readonly journalDir: string;
+	private readonly writeSlot: SlotWriter | undefined;
+
+	constructor(authPath: string, writeSlot?: SlotWriter) {
+		this.bucketPath = join(dirname(authPath), "accounts.json");
+		this.journalDir = join(dirname(authPath), "accounts.rotations");
+		this.writeSlot = writeSlot;
+	}
+
+	private label(providerId: string, name: string): string {
+		return `account ${providerId}/${name} (${accountEnvName(providerId)})`;
+	}
+
+	private readBucket(): Bucket {
+		if (!existsSync(this.bucketPath)) return {};
+		try {
+			const parsed = JSON.parse(stripBom(readFileSync(this.bucketPath, "utf-8")));
+			return parsed && typeof parsed === "object" && !Array.isArray(parsed) ? parsed : {};
+		} catch (error) {
+			throw new AccountSelectionError(
+				`Cannot read ${this.bucketPath}: ${error instanceof Error ? error.message : String(error)}`,
+			);
+		}
+	}
+
+	private entry(bucket: Bucket, providerId: string, name: string): Credential {
+		const credential = bucket.accounts?.[providerId]?.[name];
+		if (!credential || typeof credential !== "object") {
+			throw new AccountSelectionError(
+				`${this.label(providerId, name)} does not exist in ${this.bucketPath}; check /accounts list or pick another account`,
+			);
+		}
+		if (credential.type === "oauth" && typeof credential.refresh !== "string") {
+			throw new AccountSelectionError(`${this.label(providerId, name)} has no refresh token; log in to it again`);
+		}
+		return credential;
+	}
+
+	read(providerId: string, name: string): Credential {
+		assertCompatibleWriters(providerId, name);
+		return structuredClone(this.entry(this.readBucket(), providerId, name));
+	}
+
+	/** Providers selected by env, with the stored credential type (oauth when the entry is missing). */
+	selected(knownIds: Iterable<string>, env: NodeJS.ProcessEnv = process.env): CredentialInfo[] {
+		let bucket: Bucket = {};
+		try {
+			bucket = this.readBucket();
+		} catch {
+			// read() reports the unreadable bucket; listing stays best-effort.
+		}
+		const ids = new Set([...KNOWN_PROVIDERS, ...Object.keys(bucket.accounts ?? {}), ...knownIds]);
+		const result: CredentialInfo[] = [];
+		for (const providerId of ids) {
+			const name = selectedAccount(providerId, env);
+			if (!name) continue;
+			result.push({ providerId, type: bucket.accounts?.[providerId]?.[name]?.type ?? "oauth" });
+		}
+		return result;
+	}
+
+	// ---------- rotation journal ----------
+
+	/** Best-effort: a journal that cannot be written must not cost the rotated token (it is in memory). */
+	private journal(rotation: Rotation): string | undefined {
+		try {
+			mkdirSync(this.journalDir, { recursive: true, mode: 0o700 });
+			const file = join(this.journalDir, `${Date.now()}-${process.pid}-${Math.random().toString(36).slice(2)}.json`);
+			this.atomicWrite(file, JSON.stringify(rotation));
+			return file;
+		} catch {
+			return undefined;
+		}
+	}
+
+	private journals(): { file: string; rotation: Rotation }[] {
+		if (!existsSync(this.journalDir)) return [];
+		const result: { file: string; rotation: Rotation }[] = [];
+		for (const name of readdirSync(this.journalDir)
+			.filter((entry) => entry.endsWith(".json"))
+			.sort()) {
+			const file = join(this.journalDir, name);
+			try {
+				const rotation = JSON.parse(readFileSync(file, "utf-8")) as Rotation;
+				if (typeof rotation?.provider === "string" && typeof rotation.from === "string" && rotation.to) {
+					result.push({ file, rotation });
+				}
+			} catch {
+				// Half-written by a killed process before the rename: never valid, ignore.
+			}
+		}
+		return result;
+	}
+
+	/** Chains rotations over one credential: R0 -> R1 -> R2 yields R2's credential. */
+	private static follow(credential: Credential | undefined, rotations: Rotation[]): Credential | undefined {
+		let current = credential;
+		let changed = false;
+		for (let moved = true, hops = 0; moved && hops <= rotations.length; hops++) {
+			moved = false;
+			for (const rotation of rotations) {
+				if (current?.type === "oauth" && current.refresh === rotation.from) {
+					current = rotation.to;
+					changed = moved = true;
+				}
+			}
+		}
+		return changed ? current : undefined;
+	}
+
+	/** Bucket part of a replay; the caller holds the accounts.json lock. */
+	private applyToBucket(rotations: Rotation[]): void {
+		if (rotations.length === 0) return;
+		const bucket = this.readBucket();
+		let changed = false;
+		for (const [provider, entries] of Object.entries(bucket.accounts ?? {})) {
+			const own = rotations.filter((rotation) => rotation.provider === provider);
+			for (const [name, credential] of Object.entries(entries)) {
+				const next = AccountCredentials.follow(credential, own);
+				if (next) {
+					entries[name] = next;
+					changed = true;
+				}
+			}
+		}
+		if (changed) this.atomicWrite(this.bucketPath, JSON.stringify(bucket, null, 2));
+	}
+
+	/** Full replay (bucket, then auth.json slots); the caller holds the accounts.json lock only. */
+	private async replay(locked: Locked, options?: AuthOperationOptions): Promise<void> {
+		const pending = this.journals();
+		if (pending.length === 0 || locked.compromised()) return;
+		const rotations = pending.map((entry) => entry.rotation);
+		let bucketApplied = true;
+		try {
+			this.applyToBucket(rotations);
+		} catch (error) {
+			// Unreadable accounts.json must not block the auth.json slots; keep the journal for later.
+			if (!(error instanceof AccountSelectionError)) throw error;
+			bucketApplied = false;
+		}
+		if (this.writeSlot) {
+			for (const provider of new Set(rotations.map((rotation) => rotation.provider))) {
+				const own = rotations.filter((rotation) => rotation.provider === provider);
+				await this.writeSlot(provider, async (slot) => AccountCredentials.follow(slot, own), options);
+			}
+		}
+		if (locked.compromised() || !bucketApplied) return;
+		for (const { file } of pending) rmSync(file, { force: true });
+	}
+
+	/** Pending journal after a failure: reacquire the lock and replay; true when it was applied. */
+	private async recover(file: string, options?: AuthOperationOptions): Promise<boolean> {
+		try {
+			await this.withLock(options?.signal, (locked) => this.replay(locked, options));
+		} catch {
+			// The journal stays on disk; the next locked operation of any process replays it.
+		}
+		return !existsSync(file);
+	}
+
+	// ---------- operations ----------
+
+	/**
+	 * Refresh/modify of the selected entry. When the account is the provider's global active one,
+	 * the refresh runs inside the auth.json lock too and the slot receives the rotation.
+	 */
+	async modify(
+		providerId: string,
+		name: string,
+		fn: (current: Credential | undefined) => Promise<Credential | undefined>,
+		options?: AuthOperationOptions,
+	): Promise<Credential> {
+		assertCompatibleWriters(providerId, name);
+		if (!existsSync(this.bucketPath)) this.entry({}, providerId, name);
+		let pending: { file: string | undefined; to: Credential } | undefined;
+		let recovered = false;
+		const recoverOnce = async (): Promise<boolean> => {
+			if (recovered || !pending?.file) return false;
+			recovered = true;
+			return this.recover(pending.file, options);
+		};
+		try {
+			return await this.withLock(options?.signal, async (locked) => {
+				await this.replay(locked, options);
+				if (locked.compromised()) throw new AccountSelectionError(`${this.bucketPath} lock was lost; retry`);
+				const bucket = this.readBucket();
+				const current = this.entry(bucket, providerId, name);
+				const apply = async (base: Credential): Promise<Credential> => {
+					let result: Credential;
+					try {
+						result = (await fn(structuredClone(base))) ?? base;
+					} catch (error) {
+						if (error instanceof Error) error.message = `${error.message} [${this.label(providerId, name)}]`;
+						throw error;
+					}
+					if (result.type !== base.type) {
+						throw new AccountSelectionError(
+							`${this.label(providerId, name)}: credential type cannot change here; use /accounts`,
+						);
+					}
+					if (rotated(base, result)) {
+						const rotation = { provider: providerId, from: (base as { refresh: string }).refresh, to: result };
+						pending = { file: this.journal(rotation), to: result };
+						// accounts.json first; auth.json (if any) is written after this returns.
+						if (!locked.compromised()) this.applyToBucket([rotation]);
+					} else if (JSON.stringify(result) !== JSON.stringify(base) && !locked.compromised()) {
+						// Same refresh token, new fields (e.g. access only): plain entry update.
+						const fresh = this.readBucket();
+						if (fresh.accounts?.[providerId]?.[name]) {
+							fresh.accounts[providerId][name] = result;
+							this.atomicWrite(this.bucketPath, JSON.stringify(fresh, null, 2));
+						}
+					}
+					return result;
+				};
+
+				let result: Credential = current;
+				if (bucket.active?.[providerId] === name && this.writeSlot) {
+					await this.writeSlot(
+						providerId,
+						async (slot) => {
+							result = await apply(current);
+							// Only a slot holding this account's refresh token is its copy. A diverged slot
+							// (a /login without /accounts save) is never adopted nor overwritten.
+							const chained = slot?.type === "oauth" && refreshOf(slot) === refreshOf(current);
+							return chained && JSON.stringify(slot) !== JSON.stringify(result) ? result : undefined;
+						},
+						options,
+					);
+				} else {
+					result = await apply(current);
+				}
+				if (pending && !locked.compromised()) {
+					if (pending.file) rmSync(pending.file, { force: true });
+					pending = undefined;
+				}
+				return structuredClone(result);
+			});
+		} catch (error) {
+			if (pending && (await recoverOnce())) return structuredClone(pending.to);
+			throw error;
+		} finally {
+			if (pending?.file && existsSync(pending.file)) await recoverOnce();
+		}
+	}
+
+	/**
+	 * Global path (no PI_ACCOUNT_*): the slot refresh runs under accounts.json -> auth.json, and a
+	 * rotation reaches every bucket entry holding the consumed token BEFORE auth.json is written.
+	 * `run` receives a hook to call inside the auth.json callback with (before, after).
+	 */
+	async chainGlobal<T>(
+		providerId: string,
+		run: (beforeWrite: (before: Credential | undefined, after: Credential | undefined) => void) => Promise<T>,
+		options?: AuthOperationOptions,
+	): Promise<T> {
+		if (!existsSync(this.bucketPath) && !existsSync(this.journalDir)) return run(() => {});
+		let keepJournal = false;
+		let pending: { file: string | undefined; to: Credential } | undefined;
+		let recovered = false;
+		const recoverOnce = async (): Promise<boolean> => {
+			if (recovered || !pending?.file) return false;
+			recovered = true;
+			return this.recover(pending.file, options);
+		};
+		try {
+			return await this.withLock(options?.signal, async (locked) => {
+				await this.replay(locked, options);
+				if (locked.compromised()) throw new AccountSelectionError(`${this.bucketPath} lock was lost; retry`);
+				const value = await run((before, after) => {
+					if (!rotated(before, after) || loginsInProgress.has(providerId)) return;
+					const rotation = { provider: providerId, from: (before as { refresh: string }).refresh, to: after! };
+					pending = { file: this.journal(rotation), to: after! };
+					if (locked.compromised()) return;
+					try {
+						this.applyToBucket([rotation]);
+					} catch (error) {
+						// Global session: an unreadable bucket must not cost the slot refresh. Keep the journal.
+						if (!(error instanceof AccountSelectionError)) throw error;
+						keepJournal = true;
+					}
+				});
+				if (pending && !locked.compromised() && !keepJournal) {
+					if (pending.file) rmSync(pending.file, { force: true });
+					pending = undefined;
+				}
+				return value;
+			});
+		} catch (error) {
+			if (pending && (await recoverOnce())) return pending.to as T;
+			throw error;
+		} finally {
+			if (pending?.file && existsSync(pending.file) && !keepJournal) await recoverOnce();
+		}
+	}
+
+	private atomicWrite(path: string, content: string): void {
+		const tmp = `${path}.tmp-${process.pid}-${Date.now()}`;
+		writeFileSync(tmp, content, { encoding: "utf-8", mode: 0o600 });
+		try {
+			for (let attempt = 0; ; attempt++) {
+				try {
+					renameSync(tmp, path);
+					return;
+				} catch (error) {
+					const code = (error as NodeJS.ErrnoException).code;
+					if (attempt >= 4 || (code !== "EPERM" && code !== "EBUSY")) throw error;
+					Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 25 * (attempt + 1));
+				}
+			}
+		} finally {
+			rmSync(tmp, { force: true });
+		}
+	}
+
+	/** Same protocol as FileAuthStorageBackend: `<file>.lock` directory, 30 s stale, backoff. */
+	private async withLock<T>(signal: AbortSignal | undefined, run: (locked: Locked) => Promise<T>): Promise<T> {
+		let compromised: Error | undefined;
+		const deadline = Date.now() + LOCK_STALE_MS;
+		let release: (() => Promise<void>) | undefined;
+		for (let retry = 0; !release; retry++) {
+			signal?.throwIfAborted();
+			try {
+				release = await lockfile.lock(this.bucketPath, {
+					realpath: false,
+					retries: 0,
+					stale: LOCK_STALE_MS,
+					onCompromised: (error) => {
+						compromised = error;
+					},
+				});
+			} catch (error) {
+				const remaining = deadline - Date.now();
+				if ((error as NodeJS.ErrnoException).code !== "ELOCKED" || remaining <= 0) throw error;
+				const delay = Math.min(Math.round(Math.min(10 * 2 ** retry, 1_000) * (1 + Math.random())), remaining);
+				await sleep(delay, undefined, signal ? { signal } : undefined);
+			}
+		}
+		try {
+			const result = await run({ compromised: () => compromised !== undefined });
+			if (compromised) throw compromised;
+			return result;
+		} finally {
+			await release().catch(() => {});
+		}
+	}
+}
