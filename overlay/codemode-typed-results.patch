diff --git a/packages/coding-agent/test/codemode-typed-results.test.ts b/packages/coding-agent/test/codemode-typed-results.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e3158d7e29b1fa6091003493f33bd28a5d064a65
--- /dev/null
+++ b/packages/coding-agent/test/codemode-typed-results.test.ts
@@ -0,0 +1,44 @@
+import { mkdtemp, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { expect, it } from "vitest";
+import { createFindTool } from "../src/core/tools/find.ts";
+import { createGrepTool } from "../src/core/tools/grep.ts";
+import { createReadTool } from "../src/core/tools/read.ts";
+
+it("adds typed records without changing display text", async () => {
+	const dir = await mkdtemp(join(tmpdir(), "typed-"));
+	try {
+		await writeFile(join(dir, "a.txt"), "hello\nworld\n");
+		const read = await createReadTool(dir).execute("r", { path: "a.txt", offset: 2, limit: 1 });
+		expect(read.content).toEqual([
+			{ type: "text", text: "world\n\n[1 more lines in file. Use offset=3 to continue.]" },
+		]);
+		expect(read.structuredContent).toEqual({
+			path: "a.txt",
+			text: "world",
+			offset: 2,
+			limit: 1,
+			totalLines: 3,
+			truncated: false,
+		});
+		const grep = await createGrepTool(dir).execute("g", { pattern: "hello", context: 1 });
+		expect(grep.content).toEqual([{ type: "text", text: "a.txt:1: hello\na.txt-2- world" }]);
+		expect(grep.structuredContent).toEqual({
+			matches: [{ path: "a.txt", line: 1, text: "hello" }],
+			truncated: false,
+		});
+		const empty = await createGrepTool(dir).execute("g", { pattern: "absent" });
+		expect(empty.structuredContent).toEqual({ matches: [], truncated: false });
+		const find = await createFindTool(dir, { operations: { exists: () => true, glob: () => ["a.txt"] } }).execute(
+			"f",
+			{ pattern: "*.txt" },
+		);
+		expect(find.content).toEqual([{ type: "text", text: "a.txt" }]);
+		expect(find.structuredContent).toEqual({ paths: ["a.txt"], truncated: false });
+		const limited = await createReadTool(dir).execute("r", { path: "a.txt", limit: 1 });
+		expect(limited.structuredContent).toMatchObject({ text: "hello", totalLines: 3 });
+	} finally {
+		await rm(dir, { recursive: true, force: true });
+	}
+});
