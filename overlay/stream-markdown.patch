diff --git a/packages/coding-agent/src/modes/interactive/streaming-batch.ts b/packages/coding-agent/src/modes/interactive/streaming-batch.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b227fcf45f0c0557320ecf2a797a07dc283d0d8e
--- /dev/null
+++ b/packages/coding-agent/src/modes/interactive/streaming-batch.ts
@@ -0,0 +1,71 @@
+import { getTuiFrameIntervalMs } from "@earendil-works/pi-tui";
+
+/**
+ * garime-stream: agrupa os deltas de streaming de um host.
+ *
+ * O primeiro delta de uma janela é aplicado na hora; os seguintes esperam o próximo quadro
+ * (o intervalo EFETIVO da TUI — `PI_TUI_HZ` já com o teto adaptativo) e só o último estado
+ * chega ao componente.
+ * Nada é perdido: quem fecha a mensagem, começa uma tool ou aborta chama `flush()` (aplica o
+ * pendente agora) ou `cancel()` (descarta porque já vai desenhar o estado final).
+ *
+ * O host clássico (`interactive-mode`) usa esta classe.
+ */
+export class StreamingBatch<T> {
+	#pending: T | undefined;
+	#timer: NodeJS.Timeout | undefined;
+	#lastApplyAt = 0;
+	readonly #onApply: (value: T) => void;
+	/** O intervalo efetivo de quem desenha; o default serve a quem não tem TUI à mão (bancadas). */
+	readonly #intervalMs: () => number;
+
+	constructor(onApply: (value: T) => void, intervalMs: () => number = getTuiFrameIntervalMs) {
+		this.#onApply = onApply;
+		this.#intervalMs = intervalMs;
+	}
+
+	/** O pendente que ainda não foi aplicado; os testes e o host conferem que nada ficou atrás. */
+	get pending(): T | undefined {
+		return this.#pending;
+	}
+
+	/** Há quadro agendado? Usado em teste para garantir que nenhum timer fica solto. */
+	get armed(): boolean {
+		return this.#timer !== undefined;
+	}
+
+	queue(value: T): void {
+		this.#pending = value;
+		if (this.#timer !== undefined) return;
+		const interval = Math.max(1, this.#intervalMs());
+		const elapsed = Date.now() - this.#lastApplyAt;
+		if (elapsed >= interval) {
+			this.flush();
+			return;
+		}
+		this.#timer = setTimeout(() => {
+			this.#timer = undefined;
+			this.flush();
+		}, interval - elapsed);
+	}
+
+	flush(): void {
+		this.#disarm();
+		const value = this.#pending;
+		this.#pending = undefined;
+		if (value === undefined) return;
+		this.#lastApplyAt = Date.now();
+		this.#onApply(value);
+	}
+
+	cancel(): void {
+		this.#disarm();
+		this.#pending = undefined;
+	}
+
+	#disarm(): void {
+		if (this.#timer === undefined) return;
+		clearTimeout(this.#timer);
+		this.#timer = undefined;
+	}
+}
diff --git a/packages/coding-agent/test/stream-markdown.test.ts b/packages/coding-agent/test/stream-markdown.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..43fe3431d741179668fc493d4d640e068a590f01
--- /dev/null
+++ b/packages/coding-agent/test/stream-markdown.test.ts
@@ -0,0 +1,103 @@
+import { getTuiFrameIntervalMs } from "@earendil-works/pi-tui";
+import { describe, expect, test, vi } from "vitest";
+import { InteractiveMode } from "../src/modes/interactive/interactive-mode.ts";
+import { StreamingBatch } from "../src/modes/interactive/streaming-batch.ts";
+
+describe("agrupamento de deltas no host clássico", () => {
+	type StreamingMode = {
+		applied: unknown[];
+		streamingComponent: { updateContent: (message: unknown, streaming: boolean) => void } | undefined;
+		ui: { requestRender: () => void; frameIntervalMs: () => number };
+		streamingBatch: StreamingBatch<unknown>;
+		queueStreamingUpdate: (message: unknown) => void;
+		flushStreamingUpdate: () => void;
+		cancelStreamingUpdate: () => void;
+	};
+
+	/** O modo real, sem construtor: os métodos privados e o `apply` do host são os do código. */
+	function context(): StreamingMode {
+		const applied: unknown[] = [];
+		const mode = Object.assign(Object.create(InteractiveMode.prototype), {
+			applied,
+			streamingComponent: { updateContent: (message: unknown) => applied.push(message) },
+			ui: { requestRender: () => {}, frameIntervalMs: () => getTuiFrameIntervalMs() },
+		}) as StreamingMode;
+		mode.streamingBatch = new StreamingBatch<unknown>(
+			(message) => {
+				if (!mode.streamingComponent) return;
+				mode.streamingComponent.updateContent(message, true);
+				mode.ui.requestRender();
+			},
+			() => mode.ui.frameIntervalMs(),
+		);
+		return mode;
+	}
+
+	test("vários deltas num quadro viram um único updateContent, com o último estado", () => {
+		vi.useFakeTimers();
+		try {
+			const ctx = context();
+			ctx.queueStreamingUpdate("a");
+			expect(ctx.applied).toEqual(["a"]);
+			ctx.queueStreamingUpdate("b");
+			ctx.queueStreamingUpdate("c");
+			ctx.queueStreamingUpdate("d");
+			expect(ctx.applied).toEqual(["a"]);
+			vi.advanceTimersByTime(getTuiFrameIntervalMs());
+			expect(ctx.applied).toEqual(["a", "d"]);
+			expect(ctx.streamingBatch.armed).toBe(false);
+		} finally {
+			vi.useRealTimers();
+		}
+	});
+
+	test("flush entrega o pendente na hora; cancel descarta sem timer solto", () => {
+		vi.useFakeTimers();
+		try {
+			const ctx = context();
+			ctx.queueStreamingUpdate("a");
+			ctx.queueStreamingUpdate("b");
+			ctx.flushStreamingUpdate();
+			expect(ctx.applied).toEqual(["a", "b"]);
+			expect(ctx.streamingBatch.armed).toBe(false);
+
+			ctx.queueStreamingUpdate("c");
+			ctx.cancelStreamingUpdate();
+			vi.advanceTimersByTime(1000);
+			expect(ctx.applied).toEqual(["a", "b"]);
+			expect(ctx.streamingBatch.pending).toBeUndefined();
+		} finally {
+			vi.useRealTimers();
+		}
+	});
+});
+
+describe("PI_TUI_HZ", () => {
+	test("60 Hz por padrão, 30..240 aceitos, inválido volta ao default", () => {
+		const cases: Array<[string | undefined, number]> = [
+			[undefined, 16],
+			["", 16],
+			["60", 16],
+			["120", 8],
+			["240", 4],
+			["30", 33],
+			["29", 16],
+			["241", 16],
+			["0", 16],
+			["-120", 16],
+			["abc", 16],
+			["12e3", 16],
+		];
+		const previous = process.env.PI_TUI_HZ;
+		try {
+			for (const [value, expected] of cases) {
+				if (value === undefined) delete process.env.PI_TUI_HZ;
+				else process.env.PI_TUI_HZ = value;
+				expect(getTuiFrameIntervalMs(), `PI_TUI_HZ=${value}`).toBe(expected);
+			}
+		} finally {
+			if (previous === undefined) delete process.env.PI_TUI_HZ;
+			else process.env.PI_TUI_HZ = previous;
+		}
+	});
+});
