+/**
+ * garime-stream: taxa de quadros do render throttled (streaming, timers, spinner).
+ * `PI_TUI_HZ` aceita 30..240; vazio, inválido ou fora da faixa volta a 60 Hz. Teclado
+ * não passa por aqui: `requestImmediateRender()` continua imediato.
+ */
+const DEFAULT_TUI_HZ = 60;
+const MIN_TUI_HZ = 30;
+const MAX_TUI_HZ = 240;
+/** Quadro acima disso significa que subir o Hz só gastaria CPU: o teto cai para 60 Hz. */
+const SLOW_FRAME_MS = 4;
+
+let tuiHzSource: string | undefined;
+let tuiHzInterval = Math.floor(1000 / DEFAULT_TUI_HZ);
+
+/** Intervalo mínimo entre quadros pedido pelo ambiente, em ms (sem o teto adaptativo). */
+export function getTuiFrameIntervalMs(): number {
+	const raw = process.env.PI_TUI_HZ ?? "";
+	if (raw !== tuiHzSource) {
+		tuiHzSource = raw;
+		const parsed = Number.parseFloat(raw.trim());
+		const hz = Number.isFinite(parsed) && parsed >= MIN_TUI_HZ && parsed <= MAX_TUI_HZ ? parsed : DEFAULT_TUI_HZ;
+		// Piso, para que 60 Hz continue valendo os 16 ms de sempre (1000/60 = 16,67).
+		tuiHzInterval = Math.max(1, Math.floor(1000 / hz));
+	}
+	return tuiHzInterval;
+}
+
+/** tmux e SSH pagam cada byte caro; acima de 60 Hz eles só acumulam atraso. */
+function isConstrainedTerminalSession(): boolean {
+	return Boolean(process.env.TMUX || process.env.SSH_CONNECTION || process.env.SSH_TTY);
+}
