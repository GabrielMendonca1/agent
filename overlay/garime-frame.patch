diff --git a/packages/coding-agent/src/modes/interactive/components/hanging-indent.ts b/packages/coding-agent/src/modes/interactive/components/hanging-indent.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9ce21efea4ed57c954ba34b397d6bb79544a6e6b
--- /dev/null
+++ b/packages/coding-agent/src/modes/interactive/components/hanging-indent.ts
@@ -0,0 +1,43 @@
+import type { Component } from "@earendil-works/pi-tui";
+
+/**
+ * Desenha o filho mais estreito e recua todas as linhas DEPOIS da primeira
+ * linha visível.
+ *
+ * garime-frame: a fala do agente da casa tem bullet `⏺` na primeira linha (a
+ * extensão garime-tui o escreve no texto) e as continuações alinhadas sob ele;
+ * o corpo do pensamento tem o cabeçalho na margem e o resto recuado. O
+ * `Markdown` não tem indentação pendente — o `paddingX` dele recua TODAS as
+ * linhas —, então ela vive aqui, fora dele.
+ *
+ * Linha em branco não recebe recuo: espaço à toa no fim da linha vira sujeira
+ * ao copiar do terminal.
+ */
+export class HangingIndent implements Component {
+	private readonly child: Component;
+	private readonly indent: number;
+
+	constructor(child: Component, indent: number) {
+		this.child = child;
+		this.indent = indent;
+	}
+
+	render(width: number): string[] {
+		if (this.indent <= 0) return this.child.render(width);
+		const pad = " ".repeat(this.indent);
+		const lines = this.child.render(Math.max(1, width - this.indent));
+		let seen = false;
+		return lines.map((line) => {
+			if (line.trim() === "") return line;
+			if (!seen) {
+				seen = true;
+				return line;
+			}
+			return pad + line;
+		});
+	}
+
+	invalidate(): void {
+		this.child.invalidate();
+	}
+}
diff --git a/packages/coding-agent/src/modes/interactive/components/inset-layout.ts b/packages/coding-agent/src/modes/interactive/components/inset-layout.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e7bfae770c0bea2d138cbcbb1a77c7dd3888be2a
--- /dev/null
+++ b/packages/coding-agent/src/modes/interactive/components/inset-layout.ts
@@ -0,0 +1,127 @@
+import { type Component, HStack, Spacer, VStack } from "@earendil-works/pi-tui";
+
+/** Upper bound so a stray env value cannot swallow the viewport. */
+const MAX_MARGIN = 8;
+
+/** Upper bound for the blank gap between transcript blocks. */
+const MAX_BLOCK_GAP = 4;
+
+/** Default number of blank lines between transcript blocks. */
+const DEFAULT_BLOCK_GAP = 2;
+
+/**
+ * Default horizontal margin.
+ *
+ * garime-frame: 4 é a medida do respiro R3 ("bem arejado"), a combinação que a
+ * casa adotou. `PI_TUI_MARGIN_X` continua mandando.
+ */
+const DEFAULT_MARGIN_X = 2;
+
+/**
+ * Read a TUI margin from the environment.
+ *
+ * garime-frame: margens do fullscreen são ajustáveis sem rebuild
+ * (`PI_TUI_MARGIN_X`, `PI_TUI_MARGIN_Y`), só reiniciando o pi.
+ */
+export function readTuiMargin(name: string, fallback: number, env: NodeJS.ProcessEnv = process.env): number {
+	const raw = env[name];
+	if (raw === undefined || raw.trim() === "") return clampMargin(fallback);
+	const parsed = Number.parseInt(raw.trim(), 10);
+	if (!Number.isFinite(parsed) || parsed < 0) return clampMargin(fallback);
+	return clampMargin(parsed);
+}
+
+/**
+ * Blank lines separating two transcript blocks (user message, assistant
+ * message/thinking, tool card).
+ *
+ * garime-frame: `PI_TUI_BLOCK_GAP` (0..4, default 2). Valor inválido, negativo
+ * ou não numérico volta ao default; acima do teto é limitado.
+ */
+export function readTuiBlockGap(env: NodeJS.ProcessEnv = process.env): number {
+	return Math.min(MAX_BLOCK_GAP, readTuiMargin("PI_TUI_BLOCK_GAP", DEFAULT_BLOCK_GAP, env));
+}
+
+/**
+ * Margem lateral do fullscreen.
+ *
+ * garime-frame: `PI_TUI_MARGIN_X` (0..8, default 2). Existe como função para
+ * centralizar o default do host clássico.
+ */
+export function readTuiMarginX(env: NodeJS.ProcessEnv = process.env): number {
+	return readTuiMargin("PI_TUI_MARGIN_X", DEFAULT_MARGIN_X, env);
+}
+
+/**
+ * Linhas em branco entre o último bloco do agente e o próximo pedido do
+ * usuário — o "respiro final" do turno, independente do gap comum.
+ *
+ * garime-frame: `PI_TUI_AGENT_TAIL` (0..4, default 2).
+ */
+export function readTuiAgentTail(env: NodeJS.ProcessEnv = process.env): number {
+	return Math.min(MAX_BLOCK_GAP, readTuiMargin("PI_TUI_AGENT_TAIL", 2, env));
+}
+
+/**
+ * Linhas em branco antes da FALA do agente (não do pensamento, não dos cards).
+ *
+ * garime-frame: `PI_TUI_PROSE_GAP` (0..4). Ausente, cai no gap comum — então
+ * mexer só em `PI_TUI_BLOCK_GAP` continua mexendo na tela inteira.
+ */
+export function readTuiProseGap(env: NodeJS.ProcessEnv = process.env): number {
+	if (env.PI_TUI_PROSE_GAP === undefined || env.PI_TUI_PROSE_GAP.trim() === "") return readTuiBlockGap(env);
+	return Math.min(MAX_BLOCK_GAP, readTuiMargin("PI_TUI_PROSE_GAP", DEFAULT_BLOCK_GAP, env));
+}
+
+/**
+ * Recuo pendente da fala do agente: a primeira linha leva o bullet que a
+ * extensão escreveu (`⏺ `) e as seguintes alinham sob ele.
+ *
+ * garime-frame: `PI_TUI_AGENT_INDENT` (0..4, default 2); 0 volta ao texto
+ * corrido do upstream.
+ */
+export function readTuiAgentIndent(env: NodeJS.ProcessEnv = process.env): number {
+	return Math.min(MAX_BLOCK_GAP, readTuiMargin("PI_TUI_AGENT_INDENT", 2, env));
+}
+
+/**
+ * Recuo do CORPO do pensamento, sem a barra de citação: o cabeçalho
+ * (`✻ Thinking…`, escrito pela extensão) fica na margem e o resto anda para a
+ * direita.
+ *
+ * garime-frame: `PI_TUI_THINK_INDENT` (0..4, default 2).
+ */
+export function readTuiThinkIndent(env: NodeJS.ProcessEnv = process.env): number {
+	return Math.min(MAX_BLOCK_GAP, readTuiMargin("PI_TUI_THINK_INDENT", 2, env));
+}
+
+function clampMargin(value: number): number {
+	if (!Number.isFinite(value) || value <= 0) return 0;
+	return Math.min(MAX_MARGIN, Math.floor(value));
+}
+
+/**
+ * Wrap the fullscreen layout root in blank gutters so nothing paints on the
+ * terminal edges. Horizontal gutters come first so the vertical ones span the
+ * full width and stay empty.
+ */
+export function insetLayoutRoot(content: Component, marginX: number, marginY: number): Component {
+	const x = clampMargin(marginX);
+	const y = clampMargin(marginY);
+	let node: Component = content;
+	if (x > 0) {
+		node = new HStack([
+			{ component: new Spacer(0), basis: x, grow: 0, shrink: 0 },
+			{ component: node, basis: 0, grow: 1, shrink: 1, minSize: 1 },
+			{ component: new Spacer(0), basis: x, grow: 0, shrink: 0 },
+		]);
+	}
+	if (y > 0) {
+		node = new VStack([
+			{ component: new Spacer(y), basis: y, grow: 0, shrink: 0 },
+			{ component: node, basis: 0, grow: 1, shrink: 1, minSize: 1 },
+			{ component: new Spacer(y), basis: y, grow: 0, shrink: 0 },
+		]);
+	}
+	return node;
+}
