+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { Text } from "@earendil-works/pi-tui";
+import { describe, expect, it, test } from "vitest";
+import { HangingIndent } from "../src/modes/interactive/components/hanging-indent.ts";
+import {
+	insetLayoutRoot,
+	readTuiAgentIndent,
+	readTuiAgentTail,
+	readTuiBlockGap,
+	readTuiMargin,
+	readTuiMarginX,
+	readTuiProseGap,
+	readTuiThinkIndent,
+} from "../src/modes/interactive/components/inset-layout.ts";
+
+describe("garime frame", () => {
+	test("the widget row above the editor carries no dead margin", () => {
+		const source = readFileSync(
+			fileURLToPath(new URL("../src/modes/interactive/interactive-mode.ts", import.meta.url)),
+			"utf8",
+		);
+		expect(source).toContain(
+			"this.renderWidgetContainer(this.widgetContainerAbove, this.extensionWidgetsAbove, false, false);",
+		);
+		expect(source).not.toContain(
+			"this.renderWidgetContainer(this.widgetContainerAbove, this.extensionWidgetsAbove, true, true);",
+		);
+	});
+});
+
+describe("garime frame inset layout", () => {
+	it("keeps content off the terminal edges", () => {
+		const root = insetLayoutRoot(new Text("hello", 0, 0), 2, 1);
+		const lines = root.render(20);
+
+		expect(lines[0]).toBe("");
+		expect(lines[lines.length - 1]).toBe("");
+		expect(lines[1]?.startsWith("  ")).toBe(true);
+		expect(lines[1]?.endsWith("  ")).toBe(true);
+		expect(lines[1]).toContain("hello");
+	});
+
+	it("returns the content untouched when both margins are zero", () => {
+		const content = new Text("hello", 0, 0);
+		expect(insetLayoutRoot(content, 0, 0)).toBe(content);
+	});
+
+	it("uses the house margin (R3) by default", () => {
+		expect(readTuiMarginX({})).toBe(2);
+		expect(readTuiMarginX({ PI_TUI_MARGIN_X: "2" })).toBe(2);
+		expect(readTuiMarginX({ PI_TUI_MARGIN_X: "0" })).toBe(0);
+		expect(readTuiMarginX({ PI_TUI_MARGIN_X: "999" })).toBe(8);
+		expect(readTuiMarginX({ PI_TUI_MARGIN_X: "abc" })).toBe(2);
+	});
+
+	it("reads margins from the environment and clamps them", () => {
+		expect(readTuiMargin("PI_TUI_MARGIN_X", 2, {})).toBe(2);
+		expect(readTuiMargin("PI_TUI_MARGIN_X", 2, { PI_TUI_MARGIN_X: "0" })).toBe(0);
+		expect(readTuiMargin("PI_TUI_MARGIN_X", 2, { PI_TUI_MARGIN_X: "4" })).toBe(4);
+		expect(readTuiMargin("PI_TUI_MARGIN_X", 2, { PI_TUI_MARGIN_X: "999" })).toBe(8);
+		expect(readTuiMargin("PI_TUI_MARGIN_X", 2, { PI_TUI_MARGIN_X: "abc" })).toBe(2);
+		expect(readTuiMargin("PI_TUI_MARGIN_X", 2, { PI_TUI_MARGIN_X: "-3" })).toBe(2);
+		expect(readTuiMargin("PI_TUI_TRANSCRIPT_TAIL", 2, {})).toBe(2);
+		expect(readTuiMargin("PI_TUI_TRANSCRIPT_TAIL", 2, { PI_TUI_TRANSCRIPT_TAIL: "0" })).toBe(0);
+	});
+});
+
+describe("garime frame transcript block gap", () => {
+	it("separates transcript blocks by two blank lines by default", () => {
+		expect(readTuiBlockGap({})).toBe(2);
+		expect(readTuiBlockGap({ PI_TUI_BLOCK_GAP: "" })).toBe(2);
+		expect(readTuiBlockGap({ PI_TUI_BLOCK_GAP: "  " })).toBe(2);
+	});
+
+	it("honours the configured gap and clamps it to the allowed range", () => {
+		expect(readTuiBlockGap({ PI_TUI_BLOCK_GAP: "0" })).toBe(0);
+		expect(readTuiBlockGap({ PI_TUI_BLOCK_GAP: "1" })).toBe(1);
+		expect(readTuiBlockGap({ PI_TUI_BLOCK_GAP: "4" })).toBe(4);
+		expect(readTuiBlockGap({ PI_TUI_BLOCK_GAP: "9" })).toBe(4);
+	});
+
+	it("falls back to the default on an invalid value", () => {
+		expect(readTuiBlockGap({ PI_TUI_BLOCK_GAP: "abc" })).toBe(2);
+		expect(readTuiBlockGap({ PI_TUI_BLOCK_GAP: "-1" })).toBe(2);
+		// parseInt trunca: "3.9" ainda é um inteiro legível, não um valor inválido.
+		expect(readTuiBlockGap({ PI_TUI_BLOCK_GAP: "3.9" })).toBe(3);
+	});
+
+	it("drives the block spacers of the transcript components", () => {
+		const read = (path: string) => readFileSync(fileURLToPath(new URL(path, import.meta.url)), "utf8");
+		const assistant = read("../src/modes/interactive/components/assistant-message.ts");
+		const tool = read("../src/modes/interactive/components/tool-execution.ts");
+
+		// Os dois spacers do bloco do assistente passaram a perguntar o que vem
+		// Lazy visible blocks share one gap helper; hidden thinking adds no gap.
+		expect(assistant.match(/readTuiBlockGap\(\)/g)?.length).toBe(1);
+		expect(tool).toContain("new Spacer(readTuiBlockGap())");
+	});
+});
+
+describe("garime frame breathing room (R3)", () => {
+	it("gives the end of the agent turn two blank lines by default", () => {
+		expect(readTuiAgentTail({})).toBe(2);
+		expect(readTuiAgentTail({ PI_TUI_AGENT_TAIL: "0" })).toBe(0);
+		expect(readTuiAgentTail({ PI_TUI_AGENT_TAIL: "9" })).toBe(4);
+		expect(readTuiAgentTail({ PI_TUI_AGENT_TAIL: "abc" })).toBe(2);
+	});
+
+	it("falls back to the common gap when the prose gap is unset", () => {
+		expect(readTuiProseGap({})).toBe(2);
+		expect(readTuiProseGap({ PI_TUI_BLOCK_GAP: "1" })).toBe(1);
+		expect(readTuiProseGap({ PI_TUI_BLOCK_GAP: "1", PI_TUI_PROSE_GAP: "2" })).toBe(2);
+		expect(readTuiProseGap({ PI_TUI_PROSE_GAP: "0" })).toBe(0);
+		expect(readTuiProseGap({ PI_TUI_PROSE_GAP: "  " })).toBe(2);
+	});
+
+	it("hangs the agent speech and the thinking body by two columns", () => {
+		expect(readTuiAgentIndent({})).toBe(2);
+		expect(readTuiAgentIndent({ PI_TUI_AGENT_INDENT: "0" })).toBe(0);
+		expect(readTuiThinkIndent({})).toBe(2);
+		expect(readTuiThinkIndent({ PI_TUI_THINK_INDENT: "0" })).toBe(0);
+	});
+
+	it("drives the transcript spacers of the assistant block", () => {
+		const read = (path: string) => readFileSync(fileURLToPath(new URL(path, import.meta.url)), "utf8");
+		const assistant = read("../src/modes/interactive/components/assistant-message.ts");
+		const interactive = read("../src/modes/interactive/interactive-mode.ts");
+
+		expect(assistant.match(/readTuiProseGap\(\)/g)?.length).toBe(1);
+		expect(assistant).toContain("new HangingIndent(prose, agentIndent)");
+		expect(assistant).toContain("new HangingIndent(thinkingComponent, thinkIndent)");
+		expect(interactive).toContain("new Spacer(readTuiAgentTail())");
+	});
+});
+
+describe("garime frame hanging indent", () => {
+	const lines = (text: string[], indent: number) =>
+		new HangingIndent({ render: () => text, invalidate: () => {} }, indent).render(20);
+
+	it("indents every line after the first visible one", () => {
+		expect(lines(["um", "dois", "tres"], 2)).toEqual(["um", "  dois", "  tres"]);
+	});
+
+	it("leaves blank lines alone and never indents the header", () => {
+		expect(lines(["", "cabecalho", "", "corpo"], 2)).toEqual(["", "cabecalho", "", "  corpo"]);
+	});
+
+	it("is a no-op at zero", () => {
+		expect(lines(["um", "dois"], 0)).toEqual(["um", "dois"]);
+	});
+
+	it("narrows the child by the indent", () => {
+		const widths: number[] = [];
+		const child = {
+			render: (width: number) => {
+				widths.push(width);
+				return ["x"];
+			},
+			invalidate: () => {},
+		};
+		new HangingIndent(child, 2).render(20);
+		expect(widths).toEqual([18]);
+	});
+});
+
+describe("garime frame inline code colors", () => {
+	const markdown = readFileSync(
+		fileURLToPath(new URL("../../tui/src/components/markdown.ts", import.meta.url)),
+		"utf8",
+	);
+
+	it("classifies a codespan by reference type, falling back to code", () => {
+		expect(markdown).toContain("private styleCodespan(text: string): string {");
+		expect(markdown).toContain("return theme.code(text);");
+	});
+
+	it("keeps every existing theme valid: the new tokens fall back to mdCode", () => {
+		const theme = readFileSync(
+			fileURLToPath(new URL("../src/modes/interactive/theme/theme-tokens.ts", import.meta.url)),
+			"utf8",
+		);
+		for (const token of ["mdCodeCommand", "mdCodeSymbol", "mdCodePath", "mdCodeUrl"]) {
+			expect(theme).toMatch(new RegExp(`${token}: \{[^}]*fallback: "mdCode"`));
+		}
+	});
+});
