diff --git a/packages/coding-agent/test/auth-guidance-short.test.ts b/packages/coding-agent/test/auth-guidance-short.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b0d86af37405120a524046ca8b28ac7dca668d9e
--- /dev/null
+++ b/packages/coding-agent/test/auth-guidance-short.test.ts
@@ -0,0 +1,41 @@
+import { describe, expect, it } from "vitest";
+import {
+	formatNoApiKeyFoundMessage,
+	formatNoModelSelectedMessage,
+	formatNoModelsAvailableMessage,
+	getProviderLoginHelp,
+} from "../src/core/auth-guidance.ts";
+
+describe("auth guidance without docs paths", () => {
+	const messages = [
+		formatNoModelsAvailableMessage(),
+		formatNoModelSelectedMessage(),
+		formatNoApiKeyFoundMessage("fake-provider"),
+		formatNoApiKeyFoundMessage("unknown"),
+	];
+
+	it("keeps only the short login sentence", () => {
+		expect(getProviderLoginHelp()).toBe("Use /login to log into a provider via OAuth or API key.");
+		for (const message of messages) {
+			expect(message).toContain("Use /login to log into a provider via OAuth or API key.");
+			expect(message).not.toContain("providers.md");
+			expect(message).not.toContain("models.md");
+			expect(message).not.toContain("See:");
+		}
+	});
+
+	it("composes the three messages from the short help", () => {
+		expect(formatNoModelsAvailableMessage()).toBe(
+			"No models available. Use /login to log into a provider via OAuth or API key.",
+		);
+		expect(formatNoModelSelectedMessage()).toBe(
+			"No model selected.\n\nUse /login to log into a provider via OAuth or API key.\n\nThen use /model to select a model.",
+		);
+		expect(formatNoApiKeyFoundMessage("fake-provider")).toBe(
+			"No API key found for fake-provider.\n\nUse /login to log into a provider via OAuth or API key.",
+		);
+		expect(formatNoApiKeyFoundMessage("unknown")).toBe(
+			"No API key found for the selected model.\n\nUse /login to log into a provider via OAuth or API key.",
+		);
+	});
+});
