diff --git a/packages/coding-agent/src/modes/interactive/feedback-schema.ts b/packages/coding-agent/src/modes/interactive/feedback-schema.ts
new file mode 100644
index 0000000000000000000000000000000000000000..740a018edc0c1a36fab97cb511e04950df475669
--- /dev/null
+++ b/packages/coding-agent/src/modes/interactive/feedback-schema.ts
@@ -0,0 +1,24 @@
+export interface TranscriptFeedback {
+	kind: "notice" | "recap";
+	title: string;
+	summary: string;
+	evidence: string;
+	details: string;
+}
+
+/** Validate persisted data too; resumed transcripts need not originate in this version. */
+export function parseTranscriptFeedback(value: unknown): TranscriptFeedback | undefined {
+	if (!value || typeof value !== "object") return;
+	const v = value as Record<string, unknown>;
+	if (v.kind !== "notice" && v.kind !== "recap") return;
+	for (const [key, max] of [
+		["title", 100],
+		["summary", 400],
+		["evidence", 1000],
+		["details", 1600],
+	] as const) {
+		const text = v[key];
+		if (typeof text !== "string" || !text.trim() || text.length > max || /[\x00-\x1f\x7f-\x9f]/u.test(text)) return;
+	}
+	return v as unknown as TranscriptFeedback;
+}
