new file mode 100644
index 0000000000000000000000000000000000000000..50409a3d889136b714b53cb1d8db6a54d1985920
--- /dev/null
+++ b/packages/coding-agent/src/modes/interactive/components/feedback-transcript.ts
@@ -0,0 +1,181 @@
+import {
+	type Component,
+	type EditorComponent,
+	isKeyRelease,
+	Spacer,
+	Text,
+	type TUI,
+	truncateToWidth,
+	visibleWidth,
+	wrapTextWithAnsi,
+} from "@earendil-works/pi-tui";
+import type { KeybindingsManager } from "../../../core/keybindings.ts";
+import type { FeedbackCardData } from "../run-feedback.ts";
+import { theme } from "../theme/theme.ts";
+import { readTuiMargin } from "./inset-layout.ts";
+
+/** All three glyphs have pi-tui width 1; font fallback may differ on Windows. */
+function hanging(prefix: string, body: string, width: number): string[] {
+	const indent = Math.min(2, Math.max(0, width - 1));
+	if (width <= 2) return wrapTextWithAnsi(prefix + body, width).map((line) => truncateToWidth(line, width, ""));
+	return wrapTextWithAnsi(body, width - indent).map(
+		(line, index) =>
+			(index === 0 ? prefix : " ".repeat(indent)) + truncateToWidth(line, width - visibleWidth(prefix), ""),
+	);
+}
+
+/** Plain data is retained; each render uses the current theme. */
+export class FeedbackCard implements Component {
+	readonly data: FeedbackCardData;
+	constructor(data: FeedbackCardData) {
+		this.data = data;
+	}
+	invalidate(): void {}
+	render(width: number): string[] {
+		if (width < 1) return [];
+		const lead = Math.min(2, Math.max(0, width - 3));
+		const lines = this.renderInner(width - lead);
+		return lead === 0 ? lines : lines.map((line) => (line === "" ? line : " ".repeat(lead) + line));
+	}
+	private renderInner(width: number): string[] {
+		const { kind, summary, completion } = this.data;
+		if (kind === "notice") {
+			const actions = `${theme.fg("accent", "1:")} ${theme.fg("success", "Útil")}    ${theme.fg("accent", "2:")} ${theme.fg("success", "Não útil")}    ${theme.fg("accent", "0:")} ${theme.fg("success", "Dispensar")}   ${theme.fg("dim", "(/heads-up util · nao-util · dispensar)")}`;
+			return [
+				...hanging(
+					`${theme.fg("accent", "⟁")} `,
+					`${theme.fg("muted", "Você deve saber ·")} ${theme.fg("success", summary)}`,
+					width,
+				),
+				...hanging("  ", actions, width),
+			];
+		}
+		const lines: string[] = [];
+		if (completion) {
+			const seconds = Math.max(0, Math.floor(completion.elapsedMs / 1000));
+			const duration = seconds < 60 ? `${seconds}s` : `${Math.floor(seconds / 60)}m ${seconds % 60}s`;
+			const date = new Date(completion.at);
+			const time = `${String(date.getHours()).padStart(2, "0")}:${String(date.getMinutes()).padStart(2, "0")}`;
+			lines.push(
+				...hanging(
+					theme.fg("dim", "⧗ "),
+					theme.fg(
+						"dim",
+						`Trabalhou por ${duration} · ${completion.interrupted ? "interrompido" : "concluído"} ${time}`,
+					),
+					width,
+				),
+				"",
+				"",
+			);
+		}
+		return [
+			...lines,
+			...hanging(
+				`${theme.fg("dim", "∴")} `,
+				`${theme.style("resumo:", { fg: "muted", bold: true })} ${theme.style(summary, { fg: "muted", italic: true })}`,
+				width,
+			),
+		];
+	}
+}
+
+/** One recap then one notice, independent of arrival order. No accumulated spacers. */
+export class FeedbackTranscript implements Component {
+	private notice?: FeedbackCard;
+	private recap?: FeedbackCard;
+	private response?: Text;
+	/** Line range of the notice inside the component, from the last render. */
+	private noticeRows?: { start: number; end: number };
+	invalidate(): void {
+		this.response?.invalidate();
+	}
+	add(data: FeedbackCardData): void {
+		this.response = undefined;
+		this.noticeRows = undefined;
+		if (data.kind === "notice") this.notice = new FeedbackCard(data);
+		else this.recap = new FeedbackCard(data);
+	}
+	action(action: string, response: string): void {
+		if (action === "off") {
+			this.clear();
+			return;
+		}
+		if (action === "dispensar" || action === "util" || action === "nao-util") this.notice = undefined;
+		this.response =
+			action === "saber-mais" || action === "" || action === "on" ? new Text(response, 0, 0) : undefined;
+	}
+	/**
+	 * Raw-input listener: leave typing, paste, autocomplete and modal ownership alone.
+	 *
+	 * Visibility criterion: fullscreen hosts require both follow-end and part of the notice's own line
+	 * range — not of the whole component, whose recap may be visible while the notice is not — inside
+	 * the effective clip. This also covers later working indicators and afterTranscript widgets pushing
+	 * the notice out while the viewport still follows the end. Hosts without viewport scrolling (classic
+	 * regular mode, which prints at the terminal tail) report neither capability and keep the shortcuts.
+	 */
+	interceptInput(
+		data: string,
+		ui: TUI & {
+			getFocusedComponent(): Component | null;
+			isFollowingOutput?: boolean;
+			isComponentVisible?(
+				component: Component,
+				edge?: "any" | "end",
+				rows?: { start: number; end: number },
+			): boolean | undefined;
+		},
+		editor: EditorComponent,
+		keybindings: KeybindingsManager,
+		act: (action: string) => void,
+	): { consume: true } | undefined {
+		const completionEditor = editor as EditorComponent & { isShowingAutocomplete?(): boolean };
+		if (
+			isKeyRelease(data) ||
+			!this.notice ||
+			ui.isFollowingOutput === false ||
+			ui.isComponentVisible?.(this, "any", this.noticeRows) === false ||
+			editor.getText() !== "" ||
+			ui.hasOverlay() ||
+			ui.getFocusedComponent() !== editor ||
+			completionEditor.isShowingAutocomplete?.() !== false
+		)
+			return;
+		for (const [binding, action] of [
+			["app.feedback.useful", "util"],
+			["app.feedback.not-useful", "nao-util"],
+			["app.feedback.dismiss", "dispensar"],
+		] as const) {
+			if (!keybindings.matches(data, binding)) continue;
+			act(action);
+			return { consume: true };
+		}
+	}
+	clear(): void {
+		this.notice = undefined;
+		this.recap = undefined;
+		this.response = undefined;
+		this.noticeRows = undefined;
+	}
+	render(width: number): string[] {
+		if (width < 1) return [];
+		this.noticeRows = undefined;
+		const lines: string[] = [];
+		for (const card of [this.response, this.recap, this.notice]) {
+			if (!card) continue;
+			lines.push("", "");
+			if (lines.length === 2) lines.push("");
+			const start = lines.length;
+			lines.push(...card.render(width));
+			// The blank gap above the notice is not the notice: only its own lines must be in view.
+			if (card === this.notice && lines.length > start) this.noticeRows = { start, end: lines.length - 1 };
+		}
+		if (lines.length > 0) lines.push("");
+		return lines;
+	}
+}
+
+/** One final spacer, after feedback, working indicator and extension widgets. */
+export function transcriptTail(): Spacer {
+	return new Spacer(readTuiMargin("PI_TUI_TRANSCRIPT_TAIL", 3));
+}
