+	/**
+	 * Whether any row, or the final row, of a component is inside its effective clip. `rows` narrows
+	 * the question to a line range of the component, for a part that can be out of view on its own.
+	 */
+	isComponentVisible(
+		component: Component,
+		edge: "any" | "end" = "any",
+		rows?: { start: number; end: number },
+	): boolean | undefined {
+		const find = (box: LayoutBox): LayoutBox | undefined => {
+			if (box.component === component) return box;
+			for (const child of box.children) {
+				const found = find(child);
+				if (found) return found;
+			}
+			return undefined;
+		};
+		const box = this.currentLayout === undefined ? undefined : find(this.currentLayout.root);
+		if (!box) {
+			const mounted = (root: Component): boolean => {
+				if (root === component) return true;
+				const children = (root as Component & { children?: readonly Component[] }).children;
+				return children?.some(mounted) ?? false;
+			};
+			if (!this.getMountedRoots().some(mounted)) return undefined;
+			const screen = this.previousScreen.map((line) => stripTerminalSequences(line));
+			const rendered = component.render(Math.max(1, this.terminal.columns));
+			return rendered
+				.slice(rows?.start ?? 0, rows === undefined ? undefined : rows.end + 1)
+				.map((line) => stripTerminalSequences(line).trimEnd())
+				.filter(Boolean)
+				.some((line) => screen.some((row) => row.includes(line)));
+		}
+		if (box.rect.width <= 0 || box.rect.height <= 0 || box.clip.width <= 0 || box.clip.height <= 0) return false;
+		const overlapsX = box.rect.x < box.clip.x + box.clip.width && box.rect.x + box.rect.width > box.clip.x;
+		if (!overlapsX) return false;
+		// Rows outside the allocated height are not drawn at all, even when the box overlaps the clip.
+		const offset = box.lineOffset ?? 0;
+		const firstRow = Math.max(rows?.start ?? 0, offset);
+		const lastRow = Math.min(rows?.end ?? offset + box.rect.height - 1, offset + box.rect.height - 1);
+		if (lastRow < firstRow) return false;
+		const top = box.rect.y + firstRow - offset;
+		const bottom = box.rect.y + lastRow - offset;
+		if (edge === "end") return bottom >= box.clip.y && bottom < box.clip.y + box.clip.height;
+		return top < box.clip.y + box.clip.height && bottom >= box.clip.y;
+	}
