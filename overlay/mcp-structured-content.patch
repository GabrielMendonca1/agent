+	it("shows the model structured content its text blocks do not carry", async () => {
+		const structured = { pid: 4242, window: { id: 7, title: "Chrome" } };
+		// A text summary plus structured data: the model gets the data as compact JSON after the text.
+		const summary = { content: [{ type: "text" as const, text: "Browser ready" }], structuredContent: structured };
+		const withSummary = await convertMcpResult("cua", "browser_prepare", summary);
+		expect(withSummary.content).toEqual([
+			{ type: "text", text: "Browser ready" },
+			{ type: "text", text: 'structuredContent: {"pid":4242,"window":{"id":7,"title":"Chrome"}}' },
+		]);
+		// Scripts still get the CallToolResult as sent.
+		expect(withSummary.structuredContent).toEqual(summary);
+		// A text block that already is the JSON (any formatting or key order) is not repeated.
+		const echoed = {
+			content: [
+				{ type: "text" as const, text: "Browser ready" },
+				{ type: "text" as const, text: '{ "window": { "title": "Chrome", "id": 7 }, "pid": 4242 }' },
+			],
+			structuredContent: structured,
+		};
+		expect((await convertMcpResult("cua", "browser_prepare", echoed)).content).toEqual([
+			{ type: "text", text: "Browser ready" },
+			{ type: "text", text: '{ "window": { "title": "Chrome", "id": 7 }, "pid": 4242 }' },
+		]);
+		// A text block with different JSON does not count as carrying it.
+		expect(
