+/**
+ * A text block with `result`'s structured content as compact JSON, for results whose content blocks
+ * do not carry it: servers often send a text summary in `content` and the data (ids, handles) only in
+ * `structuredContent`. Undefined without structured content or when a text block already parses to
+ * the same JSON.
+ */
+function structuredContentBlock(result: CallToolResult): TextContent | undefined {
+	if (result.structuredContent === undefined) return undefined;
+	for (const block of result.content) {
+		if (block.type !== "text") continue;
+		try {
+			if (isDeepStrictEqual(JSON.parse(block.text), result.structuredContent)) return undefined;
+		} catch {
+			// Not JSON: a summary, so it does not carry the structured content.
+		}
+	}
+	return { type: "text", text: `structuredContent: ${JSON.stringify(result.structuredContent)}` };
+}
