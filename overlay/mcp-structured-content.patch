+		).toEqual([
+			{ type: "text", text: '{"pid":1}' },
+			{ type: "text", text: 'structuredContent: {"pid":2}' },
+		]);
+		// No structured content: text only. No content blocks: pretty JSON, as before.
+		expect((await convertMcpResult("cua", "t", { content: [{ type: "text", text: "ok" }] })).content).toEqual([
+			{ type: "text", text: "ok" },
