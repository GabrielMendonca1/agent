+		expect((await convertMcpResult("cua", "t", { content: [], structuredContent: structured })).content).toEqual([
+			{ type: "text", text: JSON.stringify(structured, null, 2) },
+		]);
+		// Errors keep their text and gain the structured content.
+		expect(
+			await convertMcpResult("cua", "t", {
