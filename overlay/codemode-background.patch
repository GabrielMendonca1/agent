diff --git a/packages/coding-agent/test/codemode-background.test.ts b/packages/coding-agent/test/codemode-background.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1a253ddb69052e75b7aa724c7d1e0de825fa0ae7
--- /dev/null
+++ b/packages/coding-agent/test/codemode-background.test.ts
@@ -0,0 +1,79 @@
+import { CodemodeSandbox, parseCodemodeSource } from "@earendil-works/pi-codemode";
+import { expect, it, vi } from "vitest";
+import { executeCodemode } from "../src/extensions/codemode/execute.ts";
+
+it("validates background options", () => {
+	expect(parseCodemodeSource('// @options: {"background":true,"wait_ms":0}\nreturn 1').options).toEqual({
+		background: true,
+		waitMs: 0,
+	});
+	for (const options of [{ background: 1 }, { wait_ms: -1 }, { wait_ms: 2147483648 }]) {
+		expect(() => parseCodemodeSource(`// @options: ${JSON.stringify(options)}\nreturn 1`)).toThrow();
+	}
+});
+it("keeps fast scripts synchronous", async () => {
+	const settled = vi.fn();
+	const result = await executeCodemode("fast", { code: "return 42" }, undefined, undefined, undefined, {
+		onBackgroundSettled: settled,
+	});
+	expect(result.content).toContainEqual({ type: "text", text: "42" });
+	expect(settled).not.toHaveBeenCalled();
+});
+it("returns partial output, detaches abort, and settles once", async () => {
+	const caller = new AbortController();
+	let finish!: () => void;
+	let ownSignal: AbortSignal | undefined;
+	const execute = vi.spyOn(CodemodeSandbox.prototype, "execute").mockImplementation(async (_code, options) => {
+		ownSignal = options?.signal;
+		await new Promise<void>((resolve) => {
+			finish = resolve;
+		});
+		return { ok: true, value: "ok", output: [], calls: [], storeWrites: { set: {}, delete: [] }, durationMs: 1 };
+	});
+	const snapshot = vi
+		.spyOn(CodemodeSandbox.prototype, "outputSoFar")
+		.mockReturnValue([{ type: "text", text: "partial" }]);
+	try {
+		const settled = vi.fn();
+		const started = vi.fn();
+		const result = await executeCodemode(
+			"bg",
+			{ code: '// @options: {"wait_ms":1}\nreturn 1' },
+			caller.signal,
+			undefined,
+			undefined,
+			{ onBackgroundStarted: started, onBackgroundSettled: settled },
+		);
+		expect(result.content).toContainEqual({ type: "text", text: "partial" });
+		expect(started).toHaveBeenCalledOnce();
+		caller.abort();
+		expect(ownSignal?.aborted).toBe(false);
+		finish();
+		await vi.waitFor(() => expect(settled).toHaveBeenCalledOnce());
+		expect(settled.mock.calls[0][1].content).toContainEqual({ type: "text", text: "ok" });
+	} finally {
+		execute.mockRestore();
+		snapshot.mockRestore();
+	}
+});
+it("cancels a real detached sandbox", async () => {
+	let controller: AbortController | undefined;
+	const settled = vi.fn();
+	const result = await executeCodemode(
+		"cancel",
+		{ code: '// @options: {"background":true}\nwhile(true) {}' },
+		undefined,
+		undefined,
+		undefined,
+		{
+			onBackgroundStarted: (_id, c) => {
+				controller = c;
+			},
+			onBackgroundSettled: settled,
+		},
+	);
+	expect(result.content[0]).toMatchObject({ text: expect.stringContaining("Script running in background (job cm_") });
+	controller!.abort();
+	await vi.waitFor(() => expect(settled).toHaveBeenCalledOnce());
+	expect(settled.mock.calls[0][1].isError).toBe(true);
+});
