+import { afterEach, describe, expect, it } from "vitest";
+import { formatSkillsForPrompt, type Skill } from "../src/core/skills.ts";
+import { createSyntheticSourceInfo } from "../src/core/source-info.ts";
+
+/**
+ * agent-skill-curation: a curadoria do que é anunciado ao modelo vive no formatter, e não num
+ * wrapper de loader, para cobrir todos os consumidores de skills.
+ * Estes testes fixam o contrato: sem a variável,
+ * comportamento nativo; com a variável, a lista é autoritativa e uma lista vazia não anuncia nada.
+ */
+
+function skill(name: string, options: { disableModelInvocation?: boolean } = {}): Skill {
+	const filePath = `/skills/${name}/SKILL.md`;
+	return {
+		name,
+		description: `${name} description.`,
+		filePath,
+		baseDir: `/skills/${name}`,
+		sourceInfo: createSyntheticSourceInfo(filePath, { source: "test" }),
+		disableModelInvocation: options.disableModelInvocation ?? false,
+	};
+}
+
+function announced(result: string): string[] {
+	return [...result.matchAll(/<name>([^<]*)<\/name>/g)].map((match) => match[1]);
+}
+
+const previous = process.env.PI_AUTOMATIC_SKILLS;
+
+afterEach(() => {
+	if (previous === undefined) delete process.env.PI_AUTOMATIC_SKILLS;
+	else process.env.PI_AUTOMATIC_SKILLS = previous;
+});
+
+describe("skill curation (PI_AUTOMATIC_SKILLS)", () => {
+	it("without the env var, keeps native disable-model-invocation behaviour", () => {
+		delete process.env.PI_AUTOMATIC_SKILLS;
+		const skills = [skill("peers"), skill("secret", { disableModelInvocation: true })];
+
+		expect(announced(formatSkillsForPrompt(skills))).toEqual(["peers"]);
+	});
+
+	it("announces only the listed skills, in catalog order", () => {
+		process.env.PI_AUTOMATIC_SKILLS = "tasks,peers";
+		const skills = [skill("peers"), skill("megamind"), skill("tasks")];
+
+		expect(announced(formatSkillsForPrompt(skills))).toEqual(["peers", "tasks"]);
+	});
+
+	it("an empty list announces no skill at all", () => {
+		process.env.PI_AUTOMATIC_SKILLS = "";
+		const skills = [skill("peers"), skill("tasks")];
+
+		expect(formatSkillsForPrompt(skills)).toBe("");
+	});
+
+	it("a list of only separators and spaces announces no skill", () => {
+		process.env.PI_AUTOMATIC_SKILLS = " , ,, ";
+
+		expect(formatSkillsForPrompt([skill("peers")])).toBe("");
+	});
+
+	it("trims spaces around each name", () => {
+		process.env.PI_AUTOMATIC_SKILLS = " peers , tasks ";
+		const skills = [skill("peers"), skill("megamind"), skill("tasks")];
+
+		expect(announced(formatSkillsForPrompt(skills))).toEqual(["peers", "tasks"]);
+	});
+
+	it("an unknown name in the list is ignored instead of failing", () => {
+		process.env.PI_AUTOMATIC_SKILLS = "peers,nao-instalada";
+
+		expect(announced(formatSkillsForPrompt([skill("peers")]))).toEqual(["peers"]);
+	});
+
+	it("the env list is authoritative over disable-model-invocation", () => {
+		process.env.PI_AUTOMATIC_SKILLS = "hidden";
+		const skills = [skill("visible"), skill("hidden", { disableModelInvocation: true })];
+
+		expect(announced(formatSkillsForPrompt(skills))).toEqual(["hidden"]);
+	});
+
+	it("does not mutate the skills it was given", () => {
+		process.env.PI_AUTOMATIC_SKILLS = "peers";
+		const skills = [skill("peers"), skill("tasks")];
+		const before = structuredClone(skills);
+
+		formatSkillsForPrompt(skills);
+
+		expect(skills).toEqual(before);
+		expect(skills).toHaveLength(2);
+	});
+});
