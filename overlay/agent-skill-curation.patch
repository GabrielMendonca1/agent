+/**
+ * agent-skill-curation: curadoria opt-in do que é anunciado ao modelo.
+ *
+ * Quando `PI_AUTOMATIC_SKILLS` está **definida** (mesmo vazia), ela é a lista autoritativa dos
+ * nomes de skill anunciados no prompt: nomes separados por vírgula, espaços em volta ignorados,
+ * lista vazia = nenhuma skill anunciada. Um nome que não existe no catálogo é simplesmente
+ * ignorado. A variável não existir preserva o comportamento nativo (`disable-model-invocation`).
+ *
+ * O catálogo não muda: skills não anunciadas continuam carregáveis por nome/arquivo (comandos,
+ * picker, leitura explícita). Nada aqui escreve em disco nem muta os objetos `Skill`.
+ */
+function automaticSkillNames(): Set<string> | undefined {
+	const raw = process.env.PI_AUTOMATIC_SKILLS;
+	if (raw === undefined) return undefined;
+	return new Set(
+		raw
+			.split(",")
+			.map((name) => name.trim())
+			.filter((name) => name.length > 0),
+	);
+}
+
 /**
