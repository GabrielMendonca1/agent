diff --git a/packages/ai/test/cc-hidden-tool-names.test.ts b/packages/ai/test/cc-hidden-tool-names.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e66dda4e57a5574989bb58e1af749c00577dc7d4
--- /dev/null
+++ b/packages/ai/test/cc-hidden-tool-names.test.ts
@@ -0,0 +1,18 @@
+import { describe, expect, it } from "vitest";
+import { fromClaudeCodeName } from "../src/api/anthropic-messages.ts";
+
+const tool = (name: string) => ({ name, description: "", parameters: { type: "object", properties: {} } }) as any;
+
+describe("fromClaudeCodeName", () => {
+	it("maps to the declared tool name", () => {
+		expect(fromClaudeCodeName("Bash", [tool("bash"), tool("codemode")])).toBe("bash");
+	});
+	it("lowercases a Claude Code name whose tool is hidden from the request", () => {
+		expect(fromClaudeCodeName("Bash", [tool("codemode"), tool("jobs")])).toBe("bash");
+		expect(fromClaudeCodeName("Read", [])).toBe("read");
+	});
+	it("keeps names that are not Claude Code tools", () => {
+		expect(fromClaudeCodeName("MyTool", [tool("codemode")])).toBe("MyTool");
+		expect(fromClaudeCodeName("codemode", [tool("codemode")])).toBe("codemode");
+	});
+});
