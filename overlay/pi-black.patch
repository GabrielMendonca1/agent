+import { gunzipSync } from "node:zlib";
+import { describe, expect, it, vi } from "vitest";
+import {
+	buildClaudeCodeBillingHeader,
+	CLAUDE_CODE_GZIP_MIN_BYTES,
+	claudeCodeVersionFingerprint,
+	createClaudeCodeFetch,
+	patchClaudeCodeCch,
+	resetClaudeCodeGzipState,
+	xxHash64,
+} from "../src/api/anthropic-claude-code.ts";
+import type { Message } from "../src/types.ts";
+
+const encoder = new TextEncoder();
+const promptMessages = (prompt: string): Message[] => [{ role: "user", content: prompt, timestamp: 1 }];
+
+describe("Claude Code Anthropic request compatibility", () => {
+	it("implements standard XXH64 vectors", () => {
+		expect(xxHash64(encoder.encode("")).toString(16)).toBe("ef46db3751d8e999");
+		expect(xxHash64(encoder.encode("hello")).toString(16)).toBe("26c7827d889f6da3");
+	});
+
+	it("reproduces the recovered cc_version prompt fingerprint", async () => {
+		expect(await claudeCodeVersionFingerprint(promptMessages("Reply with exactly: PROBE_OK"))).toBe("42b");
+		expect(await buildClaudeCodeBillingHeader(promptMessages("Reply with exactly: PROBE_OK"))).toBe(
+			"x-anthropic-billing-header: cc_version=2.1.322.42b; cc_entrypoint=sdk-cli; cch=00000;",
+		);
+	});
+
+	it("fingerprints only the first text block of the first user message", async () => {
+		const shortFirst: Message[] = [
+			{
+				role: "user",
+				content: [
+					{ type: "text", text: "Repl" },
+					{ type: "text", text: "y with exactly: PROBE_OK" },
+				],
+				timestamp: 1,
+			},
+		];
+		expect(await claudeCodeVersionFingerprint(shortFirst)).toBe(
+			await claudeCodeVersionFingerprint(promptMessages("Repl")),
+		);
+		expect(await claudeCodeVersionFingerprint(shortFirst)).not.toBe("42b");
+	});
+
+	it("omits the model value and complete max_tokens member before seeded XXH64", () => {
+		const body =
+			'{"model":"claude-opus-5","messages":[{"role":"user","content":"A"}],"max_tokens":64000,"stream":true,"system":[{"type":"text","text":"x-anthropic-billing-header: cc_version=2.1.322.000; cc_entrypoint=sdk-cli; cch=00000;"}]}';
+		expect(patchClaudeCodeCch(body)).toContain("cch=4f1be");
+	});
+
+	it("omits fallbacks and fallback_credit_token before seeded XXH64", () => {
+		const body =
+			'{"model":"claude-opus-5","messages":[{"role":"user","content":"A"}],"max_tokens":64000,"stream":true,"system":[{"type":"text","text":"x-anthropic-billing-header: cc_version=2.1.322.000; cc_entrypoint=sdk-cli; cch=00000;"}],"fallbacks":[{"model":"claude-sonnet-5"}],"fallback_credit_token":"tok"}';
+		const patched = patchClaudeCodeCch(body);
+		expect(patched).toContain("cch=4f1be");
+		const sent = JSON.parse(patched) as { fallbacks: unknown; fallback_credit_token: unknown };
+		expect(sent.fallbacks).toEqual([{ model: "claude-sonnet-5" }]);
+		expect(sent.fallback_credit_token).toBe("tok");
+	});
+
+	it("patches only the billing block when user and nested fields collide", () => {
+		const body = {
+			model: "claude-opus-5",
+			messages: [{ role: "user", content: "cch=00000", model: "nested", max_tokens: 7 }],
+			max_tokens: 64000,
+			stream: true,
+			system: [
+				{
+					type: "text",
+					text: "x-anthropic-billing-header: cc_version=2.1.322.000; cc_entrypoint=sdk-cli; cch=00000;",
+				},
+				{ type: "text", text: "fake cch=00000" },
+			],
+			tools: [{ name: "probe", description: "model max_tokens cch=00000" }],
+		};
