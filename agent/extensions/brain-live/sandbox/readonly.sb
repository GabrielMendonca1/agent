(version 1)
(allow default)
(deny file-write*)
(allow file-write*
    (subpath "/private/tmp")
    (subpath "/private/var/folders")
    (subpath "/dev")
    (subpath (string-append (param "HOME") "/Library/Caches"))
    (subpath (string-append (param "HOME") "/.npm/_cacache"))
    (subpath (string-append (param "HOME") "/.npm/_logs"))
    (subpath (string-append (param "HOME") "/.cache"))
    (subpath (string-append (param "CWD") "/node_modules/.cache")))
; Metadados do projeto ficam protegidos mesmo em checkouts dentro de /tmp.
(deny file-write*
    (subpath (string-append (param "CWD") "/.git"))
    (subpath (string-append (param "CWD") "/.pi"))
    (subpath (param "PROJECT_PI")))
; O bash não precisa ler nem alterar chaves ou credenciais do perfil.
(deny file-read*
    (subpath (param "SSH"))
    (subpath (param "AWS"))
    (subpath (param "GNUPG"))
    (literal (param "AGENT_AUTH"))
    (literal (param "PI_AUTH"))
    (literal (param "PROFILE_AUTH")))
(deny file-write*
    (subpath (param "SSH"))
    (subpath (param "AWS"))
    (subpath (param "GNUPG"))
    (literal (param "AGENT_AUTH"))
    (literal (param "PI_AUTH"))
    (literal (param "PROFILE_AUTH")))
